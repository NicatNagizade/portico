DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portico_example
DB_SSLMODE=disable

# Seed volume (defaults match the full dataset)
USER_COUNT=100000
POSTS_MIN=10
POSTS_MAX=30
COMMENTS_MIN=20
COMMENTS_MAX=30
# Chance a comment gets reactions (0.0–1.0)
REACTION_CHANCE=0.35
REACTIONS_MIN=1
REACTIONS_MAX=4
