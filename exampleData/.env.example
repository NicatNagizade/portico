DB_DATABASE=postgres
DB_NAME=portico_example
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_SSLMODE=disable

# Seed volume (defaults match the full dataset)
USER_COUNT=500000
POSTS_MIN=1
POSTS_MAX=3
COMMENTS_MIN=2
COMMENTS_MAX=4
# Chance a comment gets reactions (0.0–1.0)
REACTION_CHANCE=0.35
REACTIONS_MIN=2
REACTIONS_MAX=3

USER_BATCH_SIZE=2000
